# Reference only. Supply values through the owner-approved secret manager.
# This file is not a credential, does not enable a deployment, and contains no key.
AZURE_TOKEN_CREDENTIALS=ManagedIdentityCredential
# For a selected user-assigned managed identity only:
# AZURE_CLIENT_ID=OWNER_SELECTED_MANAGED_IDENTITY_CLIENT_ID
COSMOS_SYNC_TLS_CERT=/run/tls/tls.crt
COSMOS_SYNC_TLS_KEY=/run/tls/tls.key
COSMOS_SYNC_CURSOR_KEY_BASE64=OWNER_SECRET_MANAGER_SHARED_SIGNING_KEY
COSMOS_SYNC_METRICS_TOKEN=OWNER_SECRET_MANAGER_METRICS_TOKEN
