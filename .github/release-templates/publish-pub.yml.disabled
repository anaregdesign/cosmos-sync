# Not an active workflow. After license/visibility/first-publication approval,
# copy to .github/workflows/publish-pub.yml and configure pub.dev automation.
name: Publish cosmos_sync
on:
  push:
    tags: ['cosmos_sync-v[0-9]+.[0-9]+.[0-9]+*']
jobs:
  publish:
    permissions:
      id-token: write
    uses: dart-lang/setup-dart/.github/workflows/publish.yml@6afc89df92d6eb3834022f73cd65adc8cdfcb92d
    with:
      working-directory: packages/cosmos_sync
